{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["jobs", "notes"],
  "properties": {
    "jobs": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "company",
          "role",
          "location",
          "applyUrl",
          "source",
          "posted",
          "summary",
          "jdText",
          "requirements"
        ],
        "properties": {
          "company": { "type": "string", "minLength": 1, "maxLength": 120 },
          "role": { "type": "string", "minLength": 1, "maxLength": 180 },
          "location": { "type": "string", "minLength": 1, "maxLength": 160 },
          "applyUrl": { "type": "string", "minLength": 12, "maxLength": 1200 },
          "source": { "type": "string", "minLength": 1, "maxLength": 120 },
          "posted": { "type": "string", "minLength": 1, "maxLength": 120 },
          "summary": { "type": "string", "minLength": 40, "maxLength": 1200 },
          "jdText": { "type": "string", "minLength": 120, "maxLength": 7000 },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": { "type": "string", "minLength": 2, "maxLength": 320 }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "maxLength": 320 }
    }
  }
}
