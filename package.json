{
  "name": "job-master-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "agent": "node local-agent/server.mjs",
    "build": "vite build && npm run check:bundle",
    "check:bundle": "node scripts/checkBundle.mjs",
    "test": "node --test",
    "test:python": "python3 -m unittest discover -s tests -v",
    "lint": "eslint .",
    "audit:prod": "npm audit --omit=dev",
    "check": "npm run lint && npm test && npm run test:python && npm run build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.1.200",
    "playwright-core": "1.62.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0"
  },
  "overrides": {
    "dompurify": "^3.4.12"
  }
}
